# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SIGNING_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
# Generate with: openssl rand -hex 32
SIGNING_ADMIN_TOKEN=REPLACE_WITH_LONG_RANDOM_TOKEN
# Exact GitHub owner/repository names permitted to request signatures
ALLOWED_GITHUB_REPOSITORIES=dincer552/socialworst,dincer552/dyssh,dincer552/instaviewer
APK_SIGNER_OIDC_AUDIENCE=socialworst-apk-signer
SIGNING_DATA_DIR=/var/lib/apk-signing
APKSIGNER_PATH=/opt/android-sdk/build-tools/36.0.0/apksigner
AAPT_PATH=/opt/android-sdk/build-tools/36.0.0/aapt
