diff --git a/token/launch_browser_android.go b/token/launch_browser_android.go
new file mode 100644
index 00000000..65f3c354
--- /dev/null
+++ b/token/launch_browser_android.go
@@ -0,0 +1,12 @@
+//go:build android
+
+package token
+
+import "os/exec"
+
+func getBrowserCmd(url string) *exec.Cmd {
+	// Android apps cannot reliably launch a browser from a sandboxed
+	// native subprocess. Return nil so cloudflared prints its login URL;
+	// the Android host app opens that URL using an ACTION_VIEW intent.
+	return nil
+}
